APP_NAME="Racikara"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_production_database
DB_USERNAME=replace_with_production_username
DB_PASSWORD="replace_with_production_password"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=replace_with_smtp_host
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD="replace_with_smtp_password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=replace_with_verified_sender@example.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_ADDRESS=replace_with_contact_recipient@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
